# Optional: Comma-separated list of explicit allowed origins for CORS.
# If not set, the service allows common local dev origins (localhost:3000, 5173).
# Example:
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,https://my-frontend.example.com
CORS_ALLOW_ORIGINS=

# Optional: Regex for allowed origins (Starlette/FastAPI CORS "allow_origin_regex").
# Useful for dynamic preview URLs such as Kavia cloud workspaces.
# Default (if unset) allows:
#   https://vscode-internal-<digits>-beta.beta01.cloud.kavia.ai:3000
# Example:
# CORS_ALLOW_ORIGIN_REGEX=^https://.*\.example\.com$
CORS_ALLOW_ORIGIN_REGEX=
